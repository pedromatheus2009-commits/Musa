NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/musa_dev"
JWT_SECRET=substitua_por_string_aleatoria_de_64_chars
JWT_EXPIRES_IN=7d
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=musa-avatars
RESEND_API_KEY=
CONTACT_TO_EMAIL=contato@musacasa.com.br
CORS_ORIGIN=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Métodos de pagamento dos eventos. Use "card" até ativar o Pix na conta Stripe; depois "card,pix"
STRIPE_PAYMENT_METHODS=card,pix

# WhatsApp Cloud API (Meta). Deixe TOKEN/PHONE vazios para rodar em modo simulado (apenas loga).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_LANG=pt_BR
ADMIN_WHATSAPP=
# Nomes dos templates aprovados na Meta (têm defaults)
WHATSAPP_TPL_CONFIRMACAO=confirmacao_compra
WHATSAPP_TPL_LEMBRETE=lembrete_evento
WHATSAPP_TPL_ADMIN_INSCRICAO=admin_nova_inscricao
WHATSAPP_TPL_ADMIN_LOTADO=admin_evento_lotado

# Fuso horário dos jobs agendados (lembretes/expiração de holds)
TZ=America/Sao_Paulo
