generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String               @id @default(uuid())
  email                    String               @unique
  password                 String
  nome                     String               @db.VarChar(100)
  isAdmin                  Boolean              @default(false) @map("is_admin")
  stripeCustomerId         String?              @unique @map("stripe_customer_id")
  subscriptionId           String?              @unique @map("subscription_id")
  subscriptionStatus       String?              @map("subscription_status")
  subscriptionPeriodEnd    DateTime?            @map("subscription_period_end")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  profile                  Profile?
  feedPosts                FeedPost[]
  passwordResetTokens      PasswordResetToken[]
  eventos                  Evento[]
  bauItens                 BauItem[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model Profile {
  id         String            @id @default(uuid())
  userId     String            @unique @map("user_id")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome       String            @db.VarChar(100)
  role       String
  bio        String?           @db.Text
  cidade     String?
  whatsapp   String?           @db.VarChar(20)
  preco      String?           @db.VarChar(50)
  fotoUrl    String?           @map("foto_url")
  ativo      Boolean           @default(true)
  aprovado   Boolean           @default(false)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  services   Service[]
  categories ProfileCategory[]
  reviews    Review[]
  posts      Post[]

  @@index([ativo, aprovado, createdAt])
  @@map("profiles")
}

model Service {
  id        String  @id @default(uuid())
  profileId String  @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  nome      String

  @@index([profileId])
  @@map("services")
}

model Category {
  id       Int               @id @default(autoincrement())
  nome     String            @unique
  profiles ProfileCategory[]

  @@map("categories")
}

model ProfileCategory {
  profileId  String   @map("profile_id")
  categoryId Int      @map("category_id")
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([profileId, categoryId])
  @@index([categoryId])
  @@map("profile_categories")
}

model Review {
  id         String   @id @default(uuid())
  profileId  String   @map("profile_id")
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  autorNome  String   @map("autor_nome")
  nota       Int
  comentario String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([profileId])
  @@map("reviews")
}

model FeedPost {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo    String   @db.VarChar(200)
  conteudo  String?  @db.Text
  imagemUrl String?  @map("imagem_url")
  videoUrl  String?  @map("video_url")
  publicado Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([publicado, createdAt])
  @@map("feed_posts")
}

model Post {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  titulo    String?  @db.VarChar(200)
  conteudo  String?  @db.Text
  imagemUrl String?  @map("imagem_url")
  videoUrl  String?  @map("video_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([profileId])
  @@map("posts")
}

model Partnership {
  id        String   @id @default(uuid())
  nome      String   @db.VarChar(200)
  empresa   String   @db.VarChar(200)
  email     String   @db.VarChar(200)
  tipo      String   @db.VarChar(100)
  mensagem  String   @db.Text
  lida      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([lida, createdAt])
  @@map("partnerships")
}

model Evento {
  id          String      @id @default(uuid())
  tipo        String      // oficina | aula | evento
  titulo      String      @db.VarChar(200)
  descricao   String?     @db.Text
  dataHora    DateTime    @map("data_hora")
  duracaoMin  Int?        @map("duracao_min")
  local       String?
  online      Boolean     @default(false)
  linkOnline  String?     @map("link_online")
  preco       Int         // centavos (BRL)
  vagas       Int
  imagemUrl   String?     @map("imagem_url")
  status      String      @default("rascunho") // rascunho | publicado | lotado | encerrado | cancelado
  createdById String      @map("created_by_id")
  createdBy   User        @relation(fields: [createdById], references: [id])
  inscricoes  Inscricao[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([status, dataHora])
  @@index([createdById])
  @@map("eventos")
}

model Inscricao {
  id                String    @id @default(uuid())
  eventoId          String    @map("evento_id")
  evento            Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  nome              String    @db.VarChar(150)
  email             String    @db.VarChar(200)
  whatsapp          String    @db.VarChar(20)
  status            String    @default("aguardando_pagamento") // aguardando_pagamento | confirmada | cancelada | expirada
  origem            String    @default("online") // online | manual
  valorPago         Int?      @map("valor_pago")
  stripeSessionId   String?   @unique @map("stripe_session_id")
  holdExpiresAt     DateTime? @map("hold_expires_at")
  lembreteEnviadoEm DateTime? @map("lembrete_enviado_em")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([eventoId, status])
  @@index([status, holdExpiresAt])
  @@map("inscricoes")
}

model BauItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo    String   @db.VarChar(150)
  descricao String?  @db.Text
  preco     Int?     // centavos (BRL); null = somente troca
  tipo      String   // venda | troca
  categoria String?
  fotos     String[]
  whatsapp  String   @db.VarChar(20)
  status    String   @default("pendente") // pendente | aprovado | vendido | recusado
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([userId])
  @@map("bau_itens")
}
